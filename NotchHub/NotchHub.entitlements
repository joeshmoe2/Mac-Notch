<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime: allow sending Apple Events to Music / Spotify. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened Runtime / sandbox: allow CoreLocation for the Weather module. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Hardened Runtime / sandbox: allow EventKit for the Calendar and Reminders modules. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Hardened Runtime: allow camera access for the Mirror module. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Sandbox only: Bluetooth access for the headphone pop-up. Harmless when not sandboxed. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
